{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormNET",
  "mainBinaryName": "formnet-desktop",
  "version": "0.1.3",
  "identifier": "ai.nodemode.formnet",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormNET",
        "url": "index.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "What websites, apps and the machine actually send on the network",
    "longDescription": "formNET is the network tab for the whole computer: an intercepting HTTP(S) proxy with a local root certificate, a view of every connection the machine holds and the process behind it, and a client that shows who a program calls, how often, how much it sends and what is inside. The desktop app runs a private formnet server on this computer; nothing leaves it.",
    "copyright": "Copyright 2026 NodeAgentc, Inc.",
    "externalBin": [
      "binaries/formnet-server"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICES.md": "NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  }
}
